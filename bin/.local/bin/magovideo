#!/usr/bin/env bash
# magovideo frame  VIDEO TIME...         - the frame at each TIME (20, 00:20, 1:02:03.5) -> VIDEO_00-20.jpg
# magovideo frames VIDEO START END [N=15] - N evenly spaced frames from START to END -> VIDEO_00-00_00-03_01.jpg...
# Full resolution JPEGs in "frames VIDEO.MP4/" next to the video. Reads the video in place, no copy.
set -euo pipefail

usage() { sed -n '2,3s/^# //p' "$0" >&2; exit 1; }
[ $# -ge 3 ] || usage
cmd=$1; v=$2; shift 2
[ -f "$v" ] || { echo "not found: $v" >&2; exit 1; }

dir="$(dirname "$v")/frames $(basename "$v")"
mkdir -p "$dir"
base=$(basename "${v%.*}")
secs() { awk -F: '{s=0; for (i=1; i<=NF; i++) s=s*60+$i; print s}' <<<"$1"; } # 1:02:03.5 -> 3723.5

case $cmd in
frame)
  for t in "$@"; do
    out="$dir/${base}_${t//:/-}.jpg" # ':' is not allowed in Windows names
    # -ss before -i seeks to the nearest keyframe and decodes up to the exact frame: fast and accurate
    # raw RGB to magick: ffmpeg's own JPEG encoder shifts colors on tv-range video
    if ! ffmpeg -v error -ss "$t" -i "$v" -map 0:v:0 -frames:v 1 -f image2pipe -c:v ppm - 2>/dev/null |
      magick ppm:- -quality 95 "$out" 2>/dev/null || [ ! -s "$out" ]; then
      rm -f "$out"; echo "no frame at $t (bad time or past the end)" >&2; exit 1
    fi
    echo "$out"
  done
  ;;
frames)
  [ $# -ge 2 ] || usage
  s=$1; e=$2; n=${3:-15}
  dur=$(awk -v a="$(secs "$s")" -v b="$(secs "$e")" 'BEGIN{print b-a}')
  awk -v d="$dur" 'BEGIN{exit !(d>0)}' || { echo "END must be after START" >&2; exit 1; }
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  # one decode of the range; fps=n/dur keeps exactly n evenly spaced frames
  ffmpeg -v error -ss "$s" -t "$dur" -i "$v" -map 0:v:0 -vf "fps=$n/$dur" -frames:v "$n" "$tmp/%02d.ppm"
  ls "$tmp"/*.ppm >/dev/null 2>&1 || { echo "no frames between $s and $e (past the end?)" >&2; exit 1; }
  # PPM -> JPEG in parallel, one magick per frame (loading all at once would eat GBs of RAM on 4K)
  printf '%s\n' "$tmp"/*.ppm | xargs -P "$(nproc)" -I{} sh -c \
    'magick "$1" -quality 95 "$2_$(basename "$1" .ppm).jpg"' _ {} "$dir/${base}_${s//:/-}_${e//:/-}"
  ls "$dir/${base}_${s//:/-}_${e//:/-}"_*.jpg
  ;;
*) usage ;;
esac
