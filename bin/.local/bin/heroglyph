	font["3",6] = "0000"
	font["4",0] = "0000"
	font["4",1] = "1010"
	font["4",2] = "1010"
	font["4",3] = "1110"
	font["4",4] = "0010"
	font["4",5] = "0010"
	font["4",6] = "0000"
	font["5",0] = "0000"
	font["5",1] = "1110"
	font["5",2] = "1000"
	font["5",3] = "1100"
	font["5",4] = "0010"
	font["5",5] = "1100"
	font["5",6] = "0000"
	font["6",0] = "0000"
