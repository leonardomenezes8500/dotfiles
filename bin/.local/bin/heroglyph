#!/bin/sh
# heroglyph — figlet-like pixel-art text, mini.nvim logo style: 4x7 blocky
# glyphs, no antialiasing, no font hinting artifacts. Prints ASCII block art
# to stdout, or (with -o) a colored PNG via ImageMagick.
#
# Font shapes are transcribed pixel-for-pixel from nvim-mini/assets
# logo-2/font/*.gif (MIT License, (c) Evgeni Chasnovski) — see README.md.
#
# POSIX sh + awk do all the layout; `magick` is only needed for -o.
set -eu

usage() {
	cat <<'EOF'
usage: heroglyph [options] TEXT[:COLOR] ...

  -o FILE     write a PNG
  -p PALETTE  summer, mini, spring, autumn
  -l          light variant
  -P          one PNG per palette
  -b COLOR    background
  -s SCALE    pixels per cell (default 15)
  :COLOR      #hex, accent1 or accent2
              o:accent splits a letter in two
  .env        HEROGLYPH_PALETTE, HEROGLYPH_MODE
              HEROGLYPH_BG/FG/ACCENT1/ACCENT2

  heroglyph "hello"
  heroglyph -o logo.png "hero:#E9B949" "glyph:#40B5AD"
EOF
}

# name:mode -> bg fg accent1 accent2. All real mini.hues colors (see README
# Credits), never invented — both the dark values and each scheme's own
# light-mode block, straight from colors/*.lua in their repo. mini is the
# actual mini.nvim logo (their miniwinter scheme); spring/summer/autumn are
# the other 3 bundled season schemes. mini.hues places its 8 named hues
# (red/orange/yellow/green/cyan/azure/blue/purple) at fixed 45-degree steps
# around the OKLCH hue wheel (lua/mini/hues.lua, H.make_hues) — so
# accent1/accent2 for spring/summer/autumn are each a true complementary
# pair (180 degrees apart: green+purple, azure+orange, red+cyan), one
# different pair per palette, kept the same pair of named hues between a
# palette's dark and light variant (just their light-mode hex values).
resolve_palette() {
	case "$1:$2" in
	mini:dark) base_bg="#00182A" base_fg="#D9D8AA" base_a1="#A6E1E2" base_a2="#B8E1C1" ;;
	mini:light) base_bg="#DCE4E8" base_fg="#312E29" base_a1="#016D71" base_a2="#00562E" ;;
	spring:dark) base_bg="#1C2617" base_fg="#D8DA9D" base_a1="#ABE5BE" base_a2="#F7C2EA" ;;
	spring:light) base_bg="#E0E4DE" base_fg="#2C2E33" base_a1="#006D3F" base_a2="#600051" ;;
	summer:dark) base_bg="#27211E" base_fg="#F6CC9B" base_a1="#93E4EE" base_a2="#FFC1B9" ;;
	summer:light) base_bg="#E9E1DD" base_fg="#2C2E33" base_a1="#007E87" base_a2="#700011" ;;
	autumn:dark) base_bg="#262029" base_fg="#EFCFAB" base_a1="#F1C6E2" base_a2="#B4E2C7" ;;
	autumn:light) base_bg="#E5E1E7" base_fg="#2F2E29" base_a1="#52073F" base_a2="#005E3D" ;;
	*)
		echo "heroglyph: unknown palette '$1' (mini, spring, summer, autumn)" >&2
		exit 1
		;;
	esac
}

AWKPROG=$(cat <<'AWKEOF'
function get(ch, r,    k) {
	k = ch SUBSEP r
	return (k in font) ? font[k] : "0000"
}
# style[ch,row]: which "on" pixels of a glyph go to the 2nd color instead of
# the 1st, for the handful of letters we bothered to hand-style (see -o
# TEXT:COLOR1,COLOR2 below). Not a general rule — mini.nvim only ever does
# this for one letter in its whole font (the "n" in their nvim wordmark);
# it's opt-in per letter, add more here as needed.
function get_style(ch, r,    k) {
	k = ch SUBSEP r
	return (k in style) ? style[k] : "0000"
}
BEGIN {
	font["0",0] = "0000"
	font["0",1] = "0100"
	font["0",2] = "1010"
	font["0",3] = "1010"
	font["0",4] = "1010"
