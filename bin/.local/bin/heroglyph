	font["6",5] = "1110"
	font["6",6] = "0000"
	font["7",0] = "0000"
	font["7",1] = "1110"
	font["7",2] = "0010"
	font["7",3] = "0010"
	font["7",4] = "0010"
	font["7",5] = "0010"
	font["7",6] = "0000"
	font["8",0] = "0000"
	font["8",1] = "1110"
	font["8",2] = "1010"
