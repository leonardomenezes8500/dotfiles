	font["0",6] = "0000"
	font["1",0] = "0000"
	font["1",1] = "1100"
	font["1",2] = "0100"
	font["1",3] = "0100"
	font["1",4] = "0100"
	font["1",5] = "1110"
	font["1",6] = "0000"
	font["2",0] = "0000"
	font["2",1] = "1110"
	font["2",2] = "0010"
	font["2",3] = "1110"
	font["2",4] = "1000"
	font["2",5] = "1110"
	font["2",6] = "0000"
	font["3",0] = "0000"
	font["3",1] = "1110"
